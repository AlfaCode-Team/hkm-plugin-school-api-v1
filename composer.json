{
    "name": "alfacode-team/hkm-plugin-school-api-v1",
    "description": "FROZEN adapter for the 53 legacy /api/** endpoints consumed by the React Native app and the ElimuGateway desktop client.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4"
    },
    "autoload": {
        "psr-4": {
            "Plugins\\SchoolApiV1\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plugins\\SchoolApiV1\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
